rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Planner data — read/write allowed (existing behaviour)
    match /planner/{document=**} {
      allow read, write: if true;
    }
    // Survey responses — read allowed for duplicate check, write allowed for submissions
    match /survey/{document=**} {
      allow read, write: if true;
    }
  }
}
