rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Planner data — read/write allowed (existing behaviour)
    match /planner/{document=**} {
      allow read, write: if true;
    }
    // Survey responses — anyone can write, no one can read from client
    match /survey/{document=**} {
      allow write: if true;
      allow read: if false;
    }
  }
}
